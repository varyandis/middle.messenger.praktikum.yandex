{
  "name": "webchat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && vite preview --port 3000 --strictPort",
    "deploy": "git push origin deploy",
    "lint:ts": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings=0",
    "lint:types": "tsc --noEmit",
    "lint": "npm run lint:ts && npm run lint:css && npm run lint:types",
    "test": "tsx ./node_modules/mocha/bin/mocha.js",
    "test:watch": "tsx ./node_modules/mocha/bin/mocha.js --watch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.4.0",
    "sinon": "^21.0.1",
    "stylelint": "^16.26.0",
    "stylelint-config-clean-order": "^8.0.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
