<section class="profile">
  <nav class="back">
    <button class="back__button" aria-label="Назад" onclick="history.back()">
      <span class="back__arrow">←</span>
    </button>
  </nav>

<div class="profile__head">
  <label class="profile__avatar" aria-hidden="true">
    <input type="file" name="avatar" accept="image/*" hidden />
  </label>
  <h1 class="profile__name">Изменить данные</h1>
</div>

  <form class="profile__rows" name="editProfile" method="post" action="#">
    <label class="profile__row">
      <span class="profile__label">Почта</span>
      <input class="profile__value" type="email" name="email" value="pochta@yandex.ru" required />
    </label>

    <label class="profile__row">
      <span class="profile__label">Логин</span>
      <input class="profile__value" type="text" name="login" value="ivanivanov" required />
    </label>

    <label class="profile__row">
      <span class="profile__label">Имя</span>
      <input class="profile__value" type="text" name="first_name" value="Иван" required />
    </label>

    <label class="profile__row">
      <span class="profile__label">Фамилия</span>
      <input class="profile__value" type="text" name="second_name" value="Иванов" required />
    </label>

    <label class="profile__row">
      <span class="profile__label">Имя в чате</span>
      <input class="profile__value" type="text" name="display_name" value="Иван" />
    </label>

    <label class="profile__row">
      <span class="profile__label">Телефон</span>
      <input class="profile__value" type="tel" name="phone" value="+7 (909) 967 30 30" required />
    </label>

    <div class="profile__actions" style="margin-top: 40px">
      <button type="submit" class="button-submit">Сохранить</button>
    </div>
  </form>
</section>
