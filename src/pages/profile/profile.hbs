<main class="page-centered">
  <section class="profile">
    <nav class="back">
      <button class="back__button" aria-label="Назад" onclick="history.back()">
        <span class="back__arrow">←</span>
      </button>
    </nav>

    <div class="profile__head">
      <div class="profile__avatar" aria-hidden="true"></div>
      <h1 class="profile__name">{{name}}</h1>
    </div>

    <ul class="profile__rows">
      <li class="profile__row">
        <span class="profile__label">Почта</span>
        <span class="profile__value profile__value--muted">{{email}}</span>
      </li>

      <li class="profile__row">
        <span class="profile__label">Логин</span>
        <span class="profile__value profile__value--muted">{{login}}</span>
      </li>

      <li class="profile__row">
        <span class="profile__label">Имя</span>
        <span class="profile__value profile__value--muted">{{first_name}}</span>
      </li>

      <li class="profile__row">
        <span class="profile__label">Фамилия</span>
        <span class="profile__value profile__value--muted">{{second_name}}</span>
      </li>

      <li class="profile__row">
        <span class="profile__label">Имя в чате</span>
        <span class="profile__value profile__value--muted">{{display_name}}</span>
      </li>

      <li class="profile__row">
        <span class="profile__label">Телефон</span>
        <span class="profile__value profile__value--muted">{{phone}}</span>
      </li>
    </ul>

    <nav class="profile__actions">
      <a class="profile__action" href="/src/pages/editProfile/editProfile.html">Изменить данные</a>
      <a class="profile__action" href="/src/pages/editPassword/editPassword.html">Изменить пароль</a>
      <a class="profile__action profile__action--danger" href="#">Выйти</a>
    </nav>
  </section>
</main>
