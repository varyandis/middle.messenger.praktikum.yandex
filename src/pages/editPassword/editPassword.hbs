<section class="profile">
  <nav class="back">
    <button class="back__button" aria-label="Назад" onclick="history.back()">
      <span class="back__arrow">←</span>
    </button>
  </nav>

  <div class="profile__head">
    <div class="profile__avatar" aria-hidden="true"></div>
    <h1 class="profile__name">Изменить пароль</h1>
  </div>

  <form class="profile__rows" name="changePassword" method="post" action="#">
    <label class="profile__row">
      <span class="profile__label">Старый пароль</span>
      <input class="profile__value" type="password" name="oldPassword" required />
    </label>

    <label class="profile__row">
      <span class="profile__label">Новый пароль</span>
      <input class="profile__value" type="password" name="newPassword" required />
    </label>

    <label class="profile__row">
      <span class="profile__label">Повторите новый пароль</span>
      <input class="profile__value" type="password" name="newPassword_repeat" required />
    </label>

    <div class="profile__actions" style="margin-top: 40px">
      <button type="submit" class="button-submit">Сохранить</button>
    </div>
  </form>
</section>
