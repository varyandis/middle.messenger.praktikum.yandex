    <form name="signup" autocomplete="on" method="post" action="#" class="form">
      <div class="data">
      <h1>Регистрация</h1>

      <label for="email" class="form-label">Почта</label>
        <input class="form-input" name="email" id="email" type="email" required placeholder="Почта" autofocus>
        <span></span>

      <label for="login" class="form-label">Логин</label>
        <input class="form-input" name="login" id="login" type="text" required placeholder="Логин">
        <span></span>

      <label for="first_name" class="form-label">Имя</label>
        <input class="form-input" name="first_name" id="first_name" type="text" required placeholder="Имя">
        <span></span>

      <label for="second_name" class="form-label">Фамилия</label>
        <input class="form-input" name="second_name" id="second_name" type="text" required placeholder="Фамилия">
        <span></span>

      <label for="phone" class="form-label">Телефон</label>
        <input class="form-input" name="phone" id="phone" type="text" required placeholder="Телефон">
        <span></span>

      <label for="password" class="form-label">Пароль</label>
      <input class="form-input" name="password" id="password" type="password" required placeholder="Пароль">

      <label for="password_repeat" class="form-label">Пароль (ещё раз)</label>
      <input class="form-input" name="password_repeat" id="password_repeat" type="password" required placeholder="Пароль (ещё раз)">

      </div>
      <div class="form-actions">
        <button type="submit" class="button-submit">Зарегистрироваться</button>
        <a href="/src/pages/login/login.html">Войти</a>
      </div>
    </form>
    