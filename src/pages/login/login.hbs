<main class="page-centered">
  <form name="login" autocomplete="on" method="post" action="#" class="form">
    <div class="data">
      <h1>Вход</h1>

      <label for="login" class="form-label">Логин</label>
      <input
        class="form-input"
        name="login"
        id="login"
        type="text"
        required
        placeholder="Логин"
        autocomplete="username"
        autofocus
      />
      <span class="form-error"></span>

      <label for="password" class="form-label">Пароль</label>
      <input
        class="form-input"
        name="password"
        id="password"
        type="password"
        required
        placeholder="Пароль"
        autocomplete="current-password"
      />
      <span class="form-error"></span>
    </div>

    <div class="form-actions">
      <button type="submit" class="button-submit">Авторизоваться</button>
      <nav>
        <a href="/registration">Нет аккаунта?</a>
      </nav>
    </div>
  </form>
</main>
